#!/system/bin/sh
# 边缘带宽度（逻辑像素；1 逻辑像素 = SCALE 个原始触控单位）。
# 左右上下始终指当前屏幕方向；0 = 该边不过滤。
BAND_LEFT=150
BAND_RIGHT=150
BAND_TOP=0
BAND_BOTTOM=0

# 起手帧位于边缘带、且 ABS_MT_TOUCH_MAJOR >= MAJOR 的触点整段屏蔽。
# 0 = 屏蔽所有信息完整的边缘触点（边缘手势也会失效）。
# 本机实测：指尖 12~36，拇指贴边握持 40~76。
MAJOR=40

# 首帧缺任一坐标或面积时直接放行，不用旧值猜测，也不延迟 DOWN。
SCALE=10
TOUCH_NAME=goodix_ts
ROT=auto
WEB_PORT=8089
