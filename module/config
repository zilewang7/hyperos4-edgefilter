#!/system/bin/sh
# 边缘带宽度（逻辑像素；1 逻辑像素 = SCALE 个原始触控单位）。
# 左右上下始终指当前屏幕方向；0 = 该边不过滤。
BAND_LEFT=150
BAND_RIGHT=150
BAND_TOP=0
BAND_BOTTOM=0

# 起手帧位于边缘带、且 ABS_MT_TOUCH_MAJOR >= MAJOR 的触点整段屏蔽（握持）。
# 0 = 屏蔽所有信息完整的边缘触点（边缘手势也会失效）。
# 本机实测：指尖 12~36，拇指贴边握持 40~76。
MAJOR=40

# 核心带：嵌套在外层边缘带里的一小条。落点在这里的触点先【扣住不转发】：
#   - 移动超过 CORE_SLOP -> 判定为滑动，补发起手帧后完全放行（侧滑返回不受影响）
#   - 没怎么动就抬手   -> 判定为误触点击，整段丢弃
# 因为 DOWN 从未发出，丢弃时不需要任何取消事件，不会留下幽灵触点。
# 代价：滑动起手会晚 1~2 帧（约 8~16ms）。必须 <= 对应的 BAND_*。
CORE_LEFT=40
CORE_RIGHT=40
CORE_TOP=0
CORE_BOTTOM=0
CORE_SLOP=12

# 扣住多久仍没移动就放行（毫秒），保证贴边长按仍然可用。
# 0 = 关闭核心带，退回纯边缘带过滤。
CORE_HOLD_MS=200

# 首帧缺任一坐标或面积时直接放行，不用旧值猜测，也不延迟 DOWN。
SCALE=10
TOUCH_NAME=goodix_ts
ROT=auto
WEB_PORT=8089
