#!/system/bin/sh
# 边缘防误触配置（单位：逻辑像素；1 逻辑像素 = SCALE 个原始单位）
# 左右边缘在横屏下对应屏幕左右；上下同理。设为 0 表示该边不拦。
BAND_LEFT=150
BAND_RIGHT=150
BAND_TOP=0
BAND_BOTTOM=0
# 核心带：嵌套在外层边缘带里面的一圈。落点在这里的【原地点击】会被取消掉
# （应用收到 ACTION_CANCEL，不触发点击），但滑动照常放行 —— 所以侧滑返回、
# 上滑回桌面这些手势不受影响。
# 必须 <= 对应的 BAND_*；设为 0 表示该边没有核心带。
CORE_LEFT=40
CORE_RIGHT=40
CORE_TOP=0
CORE_BOTTOM=0
# 核心带内移动超过这么多像素就当作手势（放行）；原地不动的才算点击被取消。
# 0 = 核心带内一律拦截（会废掉边缘手势）
CORE_SLOP=12
SCALE=10
TOUCH_NAME=goodix_ts
ROT=auto
# 外层带面积阈值：边缘带内接触面积 >= MAJOR 就拦掉（0 = 带内全拦）
# 实测：指尖 12~36，拇指贴着边框握持 40~76。40 能拦住握持、放过指尖。
MAJOR=40
# 设为 1 输出每次触点判定日志（调试用，平时留空）
WEB_PORT=8089
VERBOSE=
